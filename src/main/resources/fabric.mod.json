{
  "schemaVersion": 1,
  "id": "${modId}",
  "version": "${version}",
  "name": "${modName}",
  "description": "${description}",
  "authors": [
    "macuguita"
  ],
  "contact": {
    "homepage": "https://macuguita.com/",
    "sources": "https://github.com/macuguita/backpacks"
  },
  "license": "${license}",
  "icon": "assets/${modId}/icon.png",
  "mixins": [
    "${modId}.mixins.json"
  ],
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.macuguita.backpacks.common.GuitaBackpacks"
    ],
    "client": [
      "com.macuguita.backpacks.client.GuitaBackpacksClient"
    ],
    "fabric-datagen": [
      "com.macuguita.backpacks.datagen.GuitaBackpacksDatagen"
    ],
    "cardinal-components": [
      "com.macuguita.backpacks.common.components.GuitaBackpacksComponents"
    ]
  },
  "depends": {
    "fabricloader": ">=${loaderVersion}",
    "minecraft": "${minecraftVersionRange}",
    "java": ">=21",
    "fabric-api": "*",
    "macu_lib": ">=${macuLibVersion}"
  },
  "suggests": {
    "trinkets": "*"
  },
  "custom": {
    "cardinal-components": [
      "${modId}:backpacks",
      "${modId}:equipment"
    ]
  }
}
